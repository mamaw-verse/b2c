APP_NAME=HalalBenta
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# Set APP_URL to the public HTTPS URL in deployed environments for email links and branding.
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Set MEDIA_DISK to choose where uploaded media files are stored.
# Use "s3" for AWS S3, "minio" for the local MinIO service (Sail), or
# "public" for the local public disk (no object storage required).
MEDIA_DISK=minio

MINIO_ROOT_USER=sail
MINIO_ROOT_PASSWORD=password
MINIO_BUCKET=local
MINIO_ENDPOINT=http://minio:9000
MINIO_URL=

VITE_APP_NAME="${APP_NAME}"
# APP_PORT=80
# VITE_PORT=5173

# Storefront chrome (config/marketplace.php). Empty = block hidden; never
# renders a placeholder or an unbacked claim.
MARKETPLACE_TAGLINE=
MARKETPLACE_SUPPORT_EMAIL=
MARKETPLACE_SUPPORT_HOURS=
MARKETPLACE_REGISTRATION=
MARKETPLACE_PAYMENTS=
MARKETPLACE_COURIERS=
MARKETPLACE_NAV_SELL_URL=/seller/dashboard
MARKETPLACE_NAV_HELP_URL=
MARKETPLACE_CLAIM_HALAL_VERIFICATION=false
MARKETPLACE_TRUST_CERTIFICATES=false
MARKETPLACE_TRUST_COLD_CHAIN=false
MARKETPLACE_TRUST_COD=true
MARKETPLACE_SOCIAL_FACEBOOK=
MARKETPLACE_SOCIAL_INSTAGRAM=
MARKETPLACE_SOCIAL_YOUTUBE=
MARKETPLACE_AFFILIATE_ENABLED=false
MARKETPLACE_PRODUCT_VIDEO_ENABLED=false
MARKETPLACE_PRODUCT_VIDEO_MAX_KB=51200
MARKETPLACE_VIDEO_STORAGE_PREFIX=media
MARKETPLACE_PRODUCT_SHARE_ENABLED=false
MARKETPLACE_SHARE_PUBLIC_MIN=5
MARKETPLACE_SHARE_DEDUPE_MINUTES=10

# Google Sign-In (Laravel Socialite)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"

# Cloudflare Turnstile bot check (dummy always-pass keys are used outside production)
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
HUMANCHECK_ENABLED=true
HUMANCHECK_TTL=1200
HUMANCHECK_BIND_IP=false
TURNSTILE_EXPECTED_HOSTNAME=
TURNSTILE_EXPECTED_ACTION=

# Google Analytics 4
GOOGLE_ANALYTICS_ID=
GA4_PROPERTY_ID=
GOOGLE_ANALYTICS_CREDENTIALS=
